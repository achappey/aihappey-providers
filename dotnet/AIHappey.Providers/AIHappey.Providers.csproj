<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>OPENAI001;CS1998;NU1608</NoWarn>
    <Description>Reusable AI provider implementations, native clients, transports, and provider metadata. No gateway host required.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- Existing media contracts use IFormFile; this is not a dependency on a gateway host. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.30.1" />
    <PackageReference Include="Azure.AI.Translation.Text" Version="2.0.0" />
    <PackageReference Include="GTranslate" Version="2.4.0" />
    <PackageReference Include="Lara.Sdk" Version="1.11.2" />
    <PackageReference Include="Mscc.GenerativeAI" Version="2.9.8" />
    <PackageReference Include="Anthropic.SDK" Version="5.10.0" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="11.0.0-rc.3.26522.148" />
    <PackageReference Include="NJsonSchema" Version="11.6.1" />
    <PackageReference Include="OpenAI" Version="2.14.0" />
    <PackageReference Include="Microsoft.CognitiveServices.Speech" Version="1.53.0" />
    <PackageReference Include="Mistral.SDK" Version="2.3.1" />
    <PackageReference Include="ModelContextProtocol" Version="2.3.1" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../aihappey-interactions/AIHappey.Interactions.csproj" />
    <ProjectReference Include="../../../aihappey-chatcompletions/AIHappey.ChatCompletions.csproj" />
    <ProjectReference Include="../../../aihappey-messages/AIHappey.Messages.csproj" />
    <ProjectReference Include="../../../aihappey-responses/AIHappey.Responses.csproj" />
    <ProjectReference Include="../../../aihappey-openai/Decisions/AIHappey.Decisions.csproj" />
    <ProjectReference Include="../../../aihappey-openai/AIHappey.OpenAI.csproj" />
    <ProjectReference Include="../../../aihappey-unified/AIHappey.Unified.csproj" />
    <ProjectReference Include="../../../aihappey-vercel/AIHappey.Vercel.csproj" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <Content Include="../../metadata/models/**/*.json">
      <Link>Catalog/Models/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Pack>true</Pack>
      <PackagePath>catalog/Models/%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
    </Content>
    <Content Include="../../metadata/pricing/**/*.json">
      <Link>Catalog/Pricing/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Pack>true</Pack>
      <PackagePath>catalog/Pricing/%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
    </Content>
    <None Include="buildTransitive/AIHappey.Providers.targets" Pack="true" PackagePath="buildTransitive/" />
  </ItemGroup>
</Project>
